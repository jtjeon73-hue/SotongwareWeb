# Search engine ownership verification tokens.
# Leave blank until each service issues the real token.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Firebase Web SDK (sotongware 프로젝트 — NOT sotongware-control)
# Firebase Console > Project settings > Your apps > Web app 에서 확인
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sotongware.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sotongware
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# 로컬 Firebase 에뮬레이터 사용 시 (개발 모드 권장 fail-safe)
# NEXT_PUBLIC_FIREBASE_USE_EMULATOR=true
# Auth: 9099, Firestore: 8080, Functions: 5001

# Auth Phase 2A flags (not secrets — default off)
# NEXT_PUBLIC_AUTH_ALLOW_PROD=true
# NEXT_PUBLIC_AUTH_EMAIL_ENABLED=true
# NEXT_PUBLIC_AUTH_SIGNUP_ENABLED=true
# NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true

# Google Analytics 4 — Measurement ID 없으면 analytics no-op
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Toss Payments (names only — never commit real values)
# Client key may be browser-exposed; still separate test vs live.
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
# NEXT_PUBLIC_COMMERCE_PG_MODE=mock
# NEXT_PUBLIC_COMMERCE_PG_MODE=test
# COMMERCE_PG_MODE=test
# COMMERCE_ALLOWED_ORIGINS=
# NEXT_PUBLIC_COMMERCE_MOCK_CHECKOUT=true
# Server-only (Functions / Secret Manager) — NEVER NEXT_PUBLIC_
# TOSS_SECRET_KEY=
# COMMERCE_PG_MODE=mock
# ALLOW_COMMERCE_FUNCTIONS=true
# COMMERCE_SECRETS_READY=true
