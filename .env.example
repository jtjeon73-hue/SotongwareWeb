# Search engine ownership verification tokens.
# Leave blank until each service issues the real token.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Firebase Web SDK (sotongware 프로젝트 — NOT sotongware-control)
# Firebase Console > Project settings > Your apps > Web app 에서 확인
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sotongware.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sotongware
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# 로컬 Functions 에뮬레이터 사용 시
# NEXT_PUBLIC_FIREBASE_USE_EMULATOR=true

# Google Analytics 4 — Measurement ID 없으면 analytics no-op
NEXT_PUBLIC_GA_MEASUREMENT_ID=
