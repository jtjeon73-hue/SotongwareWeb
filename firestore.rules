rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin = verified custom claims only (never client-written fields / email string)
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function userProfileRef(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // fail-closed: pending / suspended cannot read member content
    function isActiveUser() {
      return isSignedIn()
        && exists(userProfileRef(request.auth.uid))
        && get(userProfileRef(request.auth.uid)).data.status == 'active';
    }

    function entitlementRef(businessId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/entitlements/$(businessId);
    }

    function hasActivePremiumEntitlement(businessId) {
      return isActiveUser()
        && exists(entitlementRef(businessId))
        && get(entitlementRef(businessId)).data.status == 'active'
        && get(entitlementRef(businessId)).data.plan == 'premium'
        && get(entitlementRef(businessId)).data.businessId == businessId
        && (
          !('expiresAt' in get(entitlementRef(businessId)).data)
          || get(entitlementRef(businessId)).data.expiresAt == null
          || get(entitlementRef(businessId)).data.expiresAt > request.time
        );
    }

    function canReadMemberContent(data) {
      return data.publicationStatus == 'published'
        && (
          data.accessLevel == 'public'
          || (isActiveUser() && data.accessLevel == 'member')
          || (isActiveUser() && data.accessLevel == 'premium' && hasActivePremiumEntitlement(data.businessId))
        );
    }

    // Client may only change explicit UI prefs — never identity/consent/privilege fields
    function onlySafeUserProfileUpdates() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['locale', 'displayName'])
        && (
          !('displayName' in request.resource.data)
          || (
            request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 80
          )
        );
    }

    function privilegeFieldsUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && (
          !('membershipGrade' in resource.data)
          || request.resource.data.membershipGrade == resource.data.membershipGrade
        )
        && (
          !('provisionedBy' in resource.data)
          || request.resource.data.provisionedBy == resource.data.provisionedBy
        )
        && (
          !('email' in resource.data)
          || request.resource.data.email == resource.data.email
        )
        && (
          !('emailVerified' in resource.data)
          || request.resource.data.emailVerified == resource.data.emailVerified
        )
        && (
          !('plan' in resource.data)
          || request.resource.data.plan == resource.data.plan
        )
        && (
          !('paymentStatus' in resource.data)
          || request.resource.data.paymentStatus == resource.data.paymentStatus
        )
        && (
          !('consentAt' in resource.data)
          || request.resource.data.consentAt == resource.data.consentAt
        )
        && (
          !('policyVersion' in resource.data)
          || request.resource.data.policyVersion == resource.data.policyVersion
        )
        && (
          !('termsVersion' in resource.data)
          || request.resource.data.termsVersion == resource.data.termsVersion
        )
        && (
          !('termsAcceptedAt' in resource.data)
          || request.resource.data.termsAcceptedAt == resource.data.termsAcceptedAt
        )
        && (
          !('privacyVersion' in resource.data)
          || request.resource.data.privacyVersion == resource.data.privacyVersion
        )
        && (
          !('privacyAcceptedAt' in resource.data)
          || request.resource.data.privacyAcceptedAt == resource.data.privacyAcceptedAt
        )
        && (
          !('tossCustomerKey' in resource.data)
          || request.resource.data.tossCustomerKey == resource.data.tossCustomerKey
        )
        && !('tossCustomerKey' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // 문의 — Functions Admin SDK만 접근
    match /contactInquiries/{id} {
      allow read, write: if false;
    }

    // 사용자 프로필 — create/동의/신원/권한은 Admin SDK / Cloud Functions만
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if false;
      allow update: if isOwner(userId)
        && onlySafeUserProfileUpdates()
        && privilegeFieldsUnchanged();
      allow delete: if false;
    }

    // 사업부 멤버십 entitlement (기존) — 관리자/서버만 부여
    match /users/{userId}/entitlements/{businessId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.businessId == businessId;
    }

    // 상품 구매 entitlement — 클라이언트 write 금지 (서버 Admin SDK만)
    match /users/{userId}/productEntitlements/{entitlementId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // 회원 콘텐츠 — 원문은 Rules로 보호
    match /memberContents/{contentId} {
      allow read: if canReadMemberContent(resource.data);
      allow write: if isAdmin();
    }

    // Commerce public catalog — published only; never store secrets here
    match /commerceProducts/{productId} {
      allow read: if resource.data.status == 'published'
        || isAdmin();
      allow write: if isAdmin();
    }

    // Internal product docs — admin claim only (never customer-readable)
    match /commerceProductInternal/{productId} {
      allow read, write: if isAdmin();
    }

    // Orders — owner/admin read; all client writes denied (server Admin SDK)
    match /commerceOrders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Payment attempts — owner/admin read; client write denied
    match /commercePaymentAttempts/{attemptId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Webhook audit — admin read only; client write denied
    match /commercePaymentWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
