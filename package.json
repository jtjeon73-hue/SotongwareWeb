{
  "name": "sotongware-web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "build:hosting": "next build",
    "deploy:hosting": "npm run build:hosting && firebase deploy --only hosting --project sotongware",
    "deploy:functions": "node scripts/refuse-unsafe-firebase-deploy.mjs",
    "deploy:all": "node scripts/refuse-unsafe-firebase-deploy.mjs",
    "test:e2e:contact": "firebase emulators:exec --only functions,firestore --project sotongware \"node scripts/e2e-contact.mjs\"",
    "test:firestore:rules": "firebase emulators:exec --only firestore --project sotongware \"node scripts/firestore-rules.test.mjs\"",
    "test:i18n:parity": "node scripts/i18n-parity.test.mjs",
    "test:i18n:rendered": "node scripts/i18n-rendered.test.mjs",
    "test:header:layout": "node scripts/header-layout.test.mjs",
    "test:publication:gate": "node scripts/publication-gate.test.mjs",
    "test:preview:commerce": "node scripts/preview-commerce-smoke.test.mjs",
    "test:preview:locale": "node scripts/preview-locale-matrix.test.mjs",
    "test:auth:phase2a": "firebase emulators:exec --only firestore --project sotongware \"node scripts/auth-phase-2a.test.mjs\"",
    "test:auth:emulator": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project sotongware \"node scripts/auth-emulator-smoke.test.mjs\"",
    "deploy:functions:auth-membership": "node scripts/deploy-auth-membership-functions.mjs",
    "deploy:functions:auth-membership:check": "node scripts/deploy-auth-membership-functions.mjs --check-only",
    "test:deploy:auth-membership-gate": "node scripts/deploy-auth-membership-gate.test.mjs",
    "test:auth:functions-options": "node scripts/auth-functions-options.test.mjs",
    "test:membership:security": "firebase emulators:exec --only firestore --project sotongware \"node scripts/membership-security.test.mjs\"",
    "test:commerce:rules": "firebase emulators:exec --only firestore --project sotongware \"node scripts/commerce-rules.test.mjs\"",
    "test:commerce:domain": "node scripts/commerce-domain.test.mjs",
    "test:commerce:checkout": "npm --prefix functions run build && node scripts/commerce-checkout.test.mjs",
    "test:commerce:functions-options": "node scripts/commerce-functions-options.test.mjs",
    "test:deploy:commerce-gate": "node scripts/deploy-commerce-gate.test.mjs",
    "test:commerce:ui": "node scripts/commerce-ui-smoke.test.mjs",
    "deploy:functions:commerce:check": "node scripts/deploy-commerce-functions.mjs --check-only",
    "deploy:functions:commerce": "node scripts/deploy-commerce-functions.mjs",
    "test:commerce:toss-window": "npm --prefix functions run build && node scripts/commerce-toss-window.test.mjs",
    "emulators:local-commerce": "node scripts/start-local-commerce-emulators.mjs",
    "test:commerce:emulator-cors": "firebase emulators:exec --only functions --project sotongware \"node scripts/commerce-emulator-cors.test.mjs\"",
    "check:recovery": "node scripts/check-recovery-readiness.mjs"
  },
  "dependencies": {
    "@tosspayments/tosspayments-sdk": "^2.8.1",
    "firebase": "^11.10.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "15.28.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  }
}
