{
  "name": "sotongware-web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "build:hosting": "next build",
    "deploy:hosting": "npm run build:hosting && firebase deploy --only hosting --project sotongware",
    "deploy:functions": "firebase deploy --only functions,firestore:rules,firestore:indexes --project sotongware",
    "deploy:all": "npm run build:hosting && firebase deploy --only hosting,functions,firestore:rules,firestore:indexes --project sotongware",
    "test:e2e:contact": "firebase emulators:exec --only functions,firestore --project sotongware \"node scripts/e2e-contact.mjs\"",
    "test:firestore:rules": "firebase emulators:exec --only firestore --project sotongware \"node scripts/firestore-rules.test.mjs\"",
    "test:i18n:parity": "node scripts/i18n-parity.test.mjs",
    "test:i18n:rendered": "node scripts/i18n-rendered.test.mjs",
    "test:header:layout": "node scripts/header-layout.test.mjs",
    "test:publication:gate": "node scripts/publication-gate.test.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "15.28.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  }
}
